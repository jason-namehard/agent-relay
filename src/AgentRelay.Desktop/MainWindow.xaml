<Window x:Class="AgentRelay.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Agent Relay" Width="1120" Height="780" MinWidth="900" MinHeight="620"
 WindowStartupLocation="CenterScreen" Background="#F4F6F8" FontFamily="Segoe UI" FontSize="13" Foreground="#172A35">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="13,7"/><Setter Property="Margin" Value="0,0,8,6"/>
   <Setter Property="Background" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#CBD5DA"/>
   <Setter Property="Foreground" Value="#172A35"/><Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Padding" Value="8,6"/><Setter Property="Margin" Value="0,3,0,10"/>
   <Setter Property="BorderBrush" Value="#CBD5DA"/><Setter Property="Background" Value="White"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style TargetType="DataGrid">
   <Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/>
   <Setter Property="CanUserAddRows" Value="False"/><Setter Property="SelectionMode" Value="Single"/>
   <Setter Property="HeadersVisibility" Value="Column"/><Setter Property="GridLinesVisibility" Value="Horizontal"/>
   <Setter Property="RowHeight" Value="34"/><Setter Property="ColumnHeaderHeight" Value="34"/>
   <Setter Property="BorderBrush" Value="#DCE3E7"/><Setter Property="HorizontalGridLinesBrush" Value="#EDF0F2"/>
   <Setter Property="Background" Value="White"/><Setter Property="AlternatingRowBackground" Value="#FAFBFC"/>
  </Style>
 </Window.Resources>
 <Grid Background="#F4F6F8">
  <Grid.ColumnDefinitions><ColumnDefinition Width="178"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#142D36">
   <DockPanel Margin="16,24,14,18">
    <StackPanel DockPanel.Dock="Top" Margin="5,0,0,28">
     <TextBlock Text="AGENT RELAY" Foreground="#FFFFFF" FontWeight="Bold" FontSize="18"/>
     <TextBlock Text="LOCAL COORDINATION" Foreground="#89B9B0" FontSize="9" Margin="0,6,0,0"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="6,20,0,0">
     <TextBlock Text="LOCAL FIRST" Foreground="#89B9B0" FontSize="10"/>
     <TextBlock Text="Explicit handoffs.&#x0a;Durable results." Foreground="#C2D3D7" FontSize="11" Margin="0,6,0,0"/>
    </StackPanel>
    <ListBox x:Name="Navigation" Background="Transparent" BorderThickness="0" Foreground="White" SelectionChanged="Navigate">
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="12,10"/><Setter Property="Margin" Value="0,2"/></Style></ListBox.ItemContainerStyle>
     <ListBoxItem Content="Home"/><ListBoxItem Content="Agents"/><ListBoxItem Content="Connections"/>
     <ListBoxItem Content="Inbox"/><ListBoxItem Content="Adapters"/><ListBoxItem Content="Audit"/><ListBoxItem Content="Settings"/>
    </ListBox>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="28,22,28,18">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,18">
    <Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="Refresh" Click="RefreshClick"/>
    <StackPanel><TextBlock x:Name="PageTitle" FontSize="27" FontWeight="SemiBold"/>
     <TextBlock Text="本机协作 · 明确授权 · 事件驱动" Foreground="#657B85" Margin="0,5,0,0"/>
    </StackPanel>
   </DockPanel>
   <Border x:Name="ErrorBanner" Grid.Row="1" Background="#FDEBE9" BorderBrush="#D98780" BorderThickness="1" Padding="12" Margin="0,0,0,12" Visibility="Collapsed">
    <TextBox x:Name="ErrorText" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0" Margin="0"/>
   </Border>
   <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <ContentControl x:Name="PageContent" HorizontalContentAlignment="Stretch"/>
   </ScrollViewer>
   <DockPanel Grid.Row="3" Margin="0,16,0,0">
    <TextBlock x:Name="StatusText" DockPanel.Dock="Right" Foreground="#247361"/>
    <TextBlock x:Name="HomePath" Foreground="#657B85" TextTrimming="CharacterEllipsis" ToolTip="Relay data directory"/>
   </DockPanel>
  </Grid>
 </Grid>
</Window>
