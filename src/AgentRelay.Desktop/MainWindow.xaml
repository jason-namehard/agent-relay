<Window x:Class="AgentRelay.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Agent Relay" Width="1120" Height="780" MinWidth="900" MinHeight="620"
 WindowStartupLocation="CenterScreen" Background="{DynamicResource PageBrush}" FontFamily="Segoe UI" FontSize="13" Foreground="{DynamicResource TextBrush}">
 <Window.Resources>
  <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ThemeResources.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary>
 </Window.Resources>
 <Grid Background="{DynamicResource PageBrush}">
  <Grid.ColumnDefinitions><ColumnDefinition Width="178"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="{DynamicResource NavBrush}">
   <DockPanel Margin="16,24,14,18">
    <StackPanel DockPanel.Dock="Top" Margin="5,0,0,28">
     <TextBlock Text="AGENT RELAY" Foreground="{DynamicResource NavTextBrush}" FontWeight="Bold" FontSize="18"/>
     <TextBlock x:Name="BrandSubtitle" Text="LOCAL COORDINATION" Foreground="{DynamicResource NavTextBrush}" Opacity="0.7" FontSize="9" Margin="0,6,0,0"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="6,20,0,0">
     <TextBlock x:Name="VersionLabel" Foreground="{DynamicResource NavTextBrush}" Opacity="0.8" FontSize="10"/>
     <TextBlock x:Name="BrandTagline" Text="Explicit handoffs.&#x0a;Durable results." Foreground="{DynamicResource NavTextBrush}" Opacity="0.7" FontSize="11" Margin="0,6,0,0"/>
    </StackPanel>
    <ListBox x:Name="Navigation" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource NavTextBrush}" ItemContainerStyle="{StaticResource NavigationItemStyle}" SelectionChanged="Navigate">
     <ListBoxItem Tag="Home"/><ListBoxItem Tag="Agents"/><ListBoxItem Tag="Connections"/>
     <ListBoxItem Tag="Settings"/>
    </ListBox>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="28,22,28,18">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,18">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Margin="0,0,20,0"><TextBlock x:Name="PageTitle" FontSize="27" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
     <TextBlock x:Name="ModeDescription" Text="本机协作 · 明确授权 · 事件驱动" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/>
    </StackPanel>
    <ComboBox x:Name="QuickLanguage" Grid.Column="1" Width="126" Height="34" VerticalAlignment="Center" Margin="0,0,12,0" SelectionChanged="QuickLanguageChanged" ToolTip="Language / 语言"/>
    <Button x:Name="RefreshButton" Grid.Column="2" Height="34" VerticalAlignment="Center" Margin="0" Content="Refresh" Click="RefreshClick"/>
   </Grid>
   <Border x:Name="ErrorBanner" Grid.Row="1" Background="#FDEBE9" BorderBrush="#D98780" BorderThickness="1" Padding="12" Margin="0,0,0,12" Visibility="Collapsed">
    <TextBox x:Name="ErrorText" IsReadOnly="True" TextWrapping="Wrap" Height="Auto" VerticalAlignment="Stretch" Background="Transparent" BorderThickness="0" Margin="0"/>
   </Border>
   <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <ContentControl x:Name="PageContent" HorizontalContentAlignment="Stretch"/>
   </ScrollViewer>
   <Grid Grid.Row="3" Margin="0,16,0,0">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock x:Name="HomePath" Margin="0,0,12,0" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" ToolTip="Relay data directory"/>
    <TextBlock x:Name="StatusText" Grid.Column="1" Foreground="{DynamicResource AccentBrush}" TextTrimming="CharacterEllipsis" MaxWidth="300" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
    <TextBlock x:Name="LedgerHint" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,4,0,0" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}">
     <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style>
    </TextBlock>
   </Grid>
  </Grid>
 </Grid>
</Window>
