<Window x:Class="AgentRelay.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Agent Relay" Icon="Assets/AgentRelay.ico" Width="1200" Height="780" MinWidth="960" MinHeight="620"
 WindowStartupLocation="CenterScreen" Background="{DynamicResource PageBrush}" FontSize="13.5" Foreground="{DynamicResource TextBrush}"
 UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
 <WindowChrome.WindowChrome>
  <WindowChrome CaptionHeight="32" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False"/>
 </WindowChrome.WindowChrome>
 <Window.Resources>
  <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ThemeResources.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary>
 </Window.Resources>
 <Grid x:Name="Root" Background="{DynamicResource PageBrush}">
  <Grid.ColumnDefinitions><ColumnDefinition Width="212"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="{DynamicResource NavBrush}">
   <DockPanel Margin="10,8,10,12">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,6,10,20">
     <Canvas Width="26" Height="26" VerticalAlignment="Center">
      <Path Data="M8.6,16.4 C11.5,10.8 14,9.6 17.6,9.4" Stroke="{DynamicResource NavTextBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
      <Ellipse Canvas.Left="3" Canvas.Top="14" Width="8" Height="8" Fill="{DynamicResource AccentBrush}"/>
      <Ellipse Canvas.Left="15" Canvas.Top="4" Width="8" Height="8" Fill="{DynamicResource AccentInkBrush}"/>
     </Canvas>
     <TextBlock Text="Agent Relay" Margin="10,0,0,0" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource NavTextBrush}"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="10,12,6,0">
     <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
      <Ellipse x:Name="HealthDot" Width="7" Height="7" Fill="{DynamicResource OkBrush}" VerticalAlignment="Center"/>
      <TextBlock x:Name="HealthText" Margin="8,0,0,0" FontSize="12" Foreground="{DynamicResource NavMutedBrush}" TextTrimming="CharacterEllipsis"/>
     </StackPanel>
     <Button x:Name="NotificationHealth" Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Left" HorizontalContentAlignment="Left"
             Padding="0" Margin="0,0,0,8" MinHeight="0" Height="20" Visibility="Collapsed" Click="NotificationHealthClick">
      <StackPanel Orientation="Horizontal">
       <Ellipse Width="7" Height="7" Fill="{DynamicResource WarnBrush}" VerticalAlignment="Center"/>
       <TextBlock x:Name="NotificationHealthText" Margin="8,0,0,0" FontSize="12" Foreground="{DynamicResource NavTextBrush}"/>
      </StackPanel>
     </Button>
     <TextBlock x:Name="VersionLabel" FontFamily="Cascadia Mono, Consolas" FontSize="11" Foreground="{DynamicResource NavMutedBrush}"/>
    </StackPanel>
    <ListBox x:Name="Navigation" Style="{StaticResource NavigationListStyle}" ItemContainerStyle="{StaticResource NavigationItemStyle}" SelectionChanged="Navigate">
     <ListBoxItem Tag="Home"/><ListBoxItem Tag="Agents"/><ListBoxItem Tag="Connections"/>
     <ListBoxItem Tag="Settings"/>
    </ListBox>
   </DockPanel>
  </Border>
  <StackPanel x:Name="CaptionButtons" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="5"/>
  <Grid Grid.Column="1" Margin="0,32,0,0">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="24,0,24,14">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Margin="0,0,16,0">
     <StackPanel Orientation="Horizontal">
      <TextBlock x:Name="PageTitle" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      <Button x:Name="PageHelp" Style="{StaticResource IconButtonStyle}" Width="26" Height="26" Margin="6,1,0,0" Cursor="Help" Visibility="Collapsed"
              Foreground="{DynamicResource FaintBrush}" ToolTipService.ShowDuration="60000" ToolTipService.InitialShowDelay="150"/>
      <Border x:Name="DemoBadge" Visibility="Collapsed" Margin="10,2,0,0" CornerRadius="10" Padding="8,2" Background="{DynamicResource WarnSoftBrush}" VerticalAlignment="Center">
       <TextBlock x:Name="DemoBadgeText" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource WarnBrush}"/>
      </Border>
     </StackPanel>
     <TextBlock x:Name="PageSubtitle" Foreground="{DynamicResource MutedBrush}" FontSize="12.5" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
    </StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
     <Button x:Name="RefreshButton" Tag="Refresh" Style="{StaticResource IconButtonStyle}" Margin="0,0,8,0" Click="RefreshClick"/>
     <StackPanel x:Name="PageActions" Orientation="Horizontal"/>
    </StackPanel>
   </Grid>
   <Border x:Name="ErrorBanner" Grid.Row="1" Background="{DynamicResource BadSoftBrush}" CornerRadius="9" Padding="12,8,8,8" Margin="24,0,24,12" Visibility="Collapsed">
    <DockPanel>
     <Border x:Name="ErrorIcon" DockPanel.Dock="Left" Margin="0,4,10,0" VerticalAlignment="Top"/>
     <Button x:Name="DismissErrorButton" DockPanel.Dock="Right" Style="{StaticResource IconButtonStyle}" Click="DismissErrorClick" VerticalAlignment="Top" Width="28" Height="28" Margin="8,0,0,0"/>
     <TextBox x:Name="ErrorText" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0" Margin="0" Padding="0,4" MinHeight="0"
              Foreground="{DynamicResource TextBrush}" MaxHeight="160" VerticalScrollBarVisibility="Auto"/>
    </DockPanel>
   </Border>
   <ContentControl x:Name="PageContent" Grid.Row="2" Margin="24,0,24,0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Focusable="False"/>
   <Grid Grid.Row="3" Margin="24,8,24,10">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <TextBlock x:Name="StatusText" Foreground="{DynamicResource FaintBrush}" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="420" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
    <TextBlock x:Name="LedgerHint" Grid.Column="1" Margin="16,0,0,0" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}">
     <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style>
    </TextBlock>
   </Grid>
  </Grid>
 </Grid>
</Window>
