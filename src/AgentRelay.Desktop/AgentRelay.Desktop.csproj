<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>AgentRelay.Desktop</AssemblyName>
    <Product>Agent Relay</Product>
    <ApplicationIcon>Assets/AgentRelay.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/AgentRelay.ico" />
    <Resource Include="Assets/Sounds/*.wav" />
    <ProjectReference Include="../AgentRelay.Core/AgentRelay.Core.csproj" />
  </ItemGroup>
</Project>
